# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "The Elm Architecture for Melange, written in Reason"
description:
  "One model, one update, one view, rendered through a virtual DOM. Pure core testable natively; browser layer built on melange.dom."
authors: ["Syamil Abdillah <abdillahsyamil77@gmail.com>"]
license: "MIT"
homepage: "https://github.com/syamilAbdillah/tea-melange"
bug-reports: "https://github.com/syamilAbdillah/tea-melange/issues"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.18" & >= "3.18"}
  "melange" {>= "6.0.1"}
  "reason" {>= "3.17"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/syamilAbdillah/tea-melange.git"
x-maintenance-intent: ["(latest)"]
