include Attr;
include Events;
type t('msg) = Tea_vdom.Vdom.t('msg);
type attr('msg) = Tea_vdom.Vdom.fact('msg);
let text = Tea_vdom.Vdom.text;
let clean = attrs =>
  List.filter(
    fun
    | Tea_vdom.Vdom.Attribute("", _) => false
    | _ => true,
    attrs,
  );
let node = (tag, attrs, kids) =>
  Tea_vdom.Vdom.node(tag, clean(attrs), kids);
let keyed = (tag, attrs, kids) =>
  Tea_vdom.Vdom.keyed(tag, clean(attrs), kids);
let map = Tea_vdom.Vdom.map;
let lazy1 = Tea_vdom.Vdom.lazy1;
let lazy2 = Tea_vdom.Vdom.lazy2;
let lazy3 = Tea_vdom.Vdom.lazy3;
